FROM docker.io/library/node:24.17.0@sha256:032e78d7e54e352129831743737e3a83171d9cc5b5896f411649c597ce0b11ea

WORKDIR /app/ui

# Copy files and set ownership to node user
COPY --chown=node:node ui /app/ui

# Install corepack and pnpm as root, then switch to non-root user
RUN npm install -g corepack@0.34.6 && corepack enable

# Switch to non-root user for security
USER node

# Install dependencies as non-root user
RUN pnpm install --frozen-lockfile

ENTRYPOINT ["pnpm", "start"]
